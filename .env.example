# ==============================================================================
# SIH26091 AI-Driven Business Advisory Assistant - Environment Variables
# ZERO-COST FINANCIAL GUARDRAIL: FREE DEVELOPER TIERS ONLY
# ==============================================================================

# 1. Open Government Data India (data.gov.in Free Developer Key)
# Get your free API key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 2. AI & NLP (Google AI Studio Free Tier - Gemini 2.0 Flash)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# 3. Frontend Mapping (Google Maps Platform Free Sandbox / Developer Key)
# Get sandbox key at: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_sandbox_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_sandbox_key_here

# 4. Geospatial & Regional Routing (MapmyIndia / Mappls Free Developer Tier)
# Get developer key at: https://developer.mappls.com/
MAPMYINDIA_API_KEY=your_mapmyindia_developer_key_here
MAPMYINDIA_REST_KEY=your_mapmyindia_developer_key_here

# Local Server Configuration
DATABASE_URL=sqlite:///./advisory_app.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
